# AWS Core Configuration
AWS_REGION=ap-south-1
ENVIRONMENT=local

# API & Gateway Configuration
API_BASE_URL=http://localhost:8000

# AWS S3 Storage
S3_BUCKET_NAME=team-knowledge-finder-knowledge-bucket

# AWS DynamoDB Tables
DYNAMODB_TABLE_NAME=team-knowledge-finder-metadata
REVIEWS_TABLE_NAME=team-knowledge-finder-reviews
CONFLICTS_TABLE_NAME=team-knowledge-finder-conflicts

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Amazon OpenSearch Serverless
OPENSEARCH_COLLECTION_ENDPOINT=
OPENSEARCH_INDEX_NAME=knowledge_chunks
OPENSEARCH_VECTOR_DIMENSION=1536
OPENSEARCH_BULK_BATCH_SIZE=50

# Amazon Bedrock Models
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
BEDROCK_GENERATION_MODEL_ID=amazon.titan-text-express-v1
BEDROCK_MAX_RETRIES=3

# RAG & Chunking Parameters
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=80
MAX_UPLOAD_SIZE_MB=25
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.5
RAG_MAX_CONTEXT_CHUNKS=5

# Phase 7 & 8 Features
CONFLICT_DETECTION_ENABLED=true
CONFLICT_CONFIDENCE_THRESHOLD=0.75
CLOUDWATCH_NAMESPACE=TeamKnowledgeFinder
LOG_LEVEL=INFO
